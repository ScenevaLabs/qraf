{
  "name": "qraf-desktop",
  "version": "0.1.0",
  "description": "qRaf desktop app: drive detection, scanning and Supabase sync",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "vendor": "node vendor.mjs",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.scenevalabs.qraf",
    "productName": "qRaf",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build-assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "qRaf"
    },
    "mac": {
      "target": "dmg",
      "icon": "build-assets/icon.icns",
      "identity": null
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "resetAdHocDarwinSignature": true
    }
  },
  "dependencies": {
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.118.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.62.1",
    "qrcode-generator": "1.4.4"
  },
  "allowScripts": {
    "electron@44.9.3": true
  }
}

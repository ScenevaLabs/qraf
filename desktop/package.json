{
  "name": "qraf-desktop",
  "version": "0.1.0",
  "description": "qRaf desktop app: drive detection, scanning and Supabase sync",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.scenevalabs.qraf",
    "productName": "qRaf",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build-assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "qRaf"
    },
    "mac": {
      "target": "dmg",
      "icon": "build-assets/icon.icns",
      "identity": null
    }
  },
  "dependencies": {
    "systeminformation": "^5.33.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright-core": "^1.62.1"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
